{
    "name": "hyrograsper/lunar-fortis",
    "description": "Fortis payment gateway integration for Lunar.",
    "keywords": [
        "Hyrograsper",
        "laravel",
        "lunar-fortis"
    ],
    "homepage": "https://github.com/hyrograsper/lunar-fortis",
    "license": "MIT",
    "authors": [
        {
            "name": "Alec Garcia",
            "email": "alec@hyrograsper.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^11.0 || ^12.0",
        "illuminate/config": "^11.0 || ^12.0",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/events": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/log": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/view": "^11.0 || ^12.0",
        "livewire/livewire": "^3.0 || ^4.0",
        "lunarphp/core": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "filament/filament": "^3.0",
        "larastan/larastan": "^2.9||^3.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1||^7.10.0",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^2.35||^3.0",
        "pestphp/pest-plugin-arch": "^2.7||^3.0",
        "pestphp/pest-plugin-laravel": "^2.4||^3.0",
        "phpstan/extension-installer": "^1.3||^2.0",
        "phpstan/phpstan-deprecation-rules": "^1.1||^2.0",
        "phpstan/phpstan-phpunit": "^1.3||^2.0",
        "phpunit/php-code-coverage": "^10.1||^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hyrograsper\\LunarFortis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyrograsper\\LunarFortis\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=256M",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "test-coverage-html": "vendor/bin/pest --coverage --coverage-html=build/coverage",
        "test-parallel": "vendor/bin/pest --parallel --processes=8",
        "test-integration": "vendor/bin/pest tests/Integration/",
        "test-integration-parallel": "vendor/bin/pest --parallel --processes=8 tests/Integration/",
        "test-unit": "vendor/bin/pest tests/Unit/",
        "format": "vendor/bin/pint",
        "quality": ["@format", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hyrograsper\\LunarFortis\\LunarFortisServiceProvider"
            ],
            "aliases": {
                "LunarFortis": "Hyrograsper\\LunarFortis\\Facades\\LunarFortis"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
